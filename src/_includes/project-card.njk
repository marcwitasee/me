{# Expects `item` to be an entry from collections.work #}
{% set d = item.data %}
{% set href = d.externalUrl if d.externalUrl else (item.url | url) %}
<article class="project-card" data-type="{{ d.type }}">
    <a class="project-card-link" href="{{ href }}"{% if d.externalUrl %} rel="noopener"{% endif %}>
        {% if d.image %}
        <div class="project-image-container">
            <img class="project-image{% if d.imageBlur %} blur-image{% endif %}" src="{{ d.image | url }}" alt="{{ d.imageAlt }}" loading="lazy">
        </div>
        {% endif %}
        <div class="project-content">
            <div class="project-meta">
                <span class="type-badge type-{{ d.type }}">{{ d.type | capitalize }}</span>
                <span class="project-dates">{{ d.dates }}</span>
            </div>
            <h3 class="project-title">{{ d.title }}</h3>
            {% if d.org %}<div class="project-org">{{ d.org }}</div>{% endif %}
            <p class="project-description">{{ d.summary }}</p>
            {% if d.highlight %}<p class="project-highlight">{{ d.highlight }}</p>{% endif %}
            <div class="project-technologies">
                {% for tech in d.technologies %}<span class="tech-badge">{{ tech }}</span>{% endfor %}
            </div>
            <span class="project-link-text">{% if d.externalUrl %}{{ d.externalLabel or 'View project' }} ↗{% else %}Read the case study →{% endif %}</span>
        </div>
    </a>
</article>
