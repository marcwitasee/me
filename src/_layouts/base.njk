<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} · {{ site.title }}{% else %}{{ site.title }} · {{ site.headline }}{% endif %}</title>
    <meta name="description" content="{{ description or site.description }}" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="{{ title or site.title }}" />
    <meta property="og:description" content="{{ description or site.description }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:image" content="{{ site.url }}{{ ogImage or '/images/profile.jpeg' }}" />

    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
    <link rel="stylesheet" href="{{ '/css/style.css' | url }}" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-nav">
        <div class="container nav-inner">
            <a class="nav-brand" href="{{ '/' | url }}">Marc Richardson</a>
            <nav aria-label="Main">
                <ul class="nav-links">
                    {% for item in site.navigation %}
                    {% set active = (page.url == item.url) or (item.url != '/' and page.url.startsWith(item.url)) %}
                    <li><a href="{{ item.url | url }}"{% if active %} aria-current="page"{% endif %}>{{ item.text }}</a></li>
                    {% endfor %}
                </ul>
            </nav>
        </div>
    </header>

    <main id="main">
        {{ content | safe }}
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <div>
                <strong>Marc Richardson</strong> · {{ site.headline }} · {{ site.location }}
                <div class="footer-meta">Last updated {{ site.updated | dateDisplay }}</div>
            </div>
            <ul class="footer-links">
                <li><a href="mailto:{{ site.author.email }}">Email</a></li>
                <li><a href="{{ site.author.linkedin }}" rel="noopener">LinkedIn</a></li>
                <li><a href="{{ site.author.github }}" rel="noopener">GitHub</a></li>
                <li><a href="{{ '/assets/resume.pdf' | url }}">Resume (PDF)</a></li>
            </ul>
        </div>
    </footer>
    {% if scripts %}{% for s in scripts %}<script src="{{ s | url }}" defer></script>{% endfor %}{% endif %}
</body>
</html>
